@page
@model RaymiMusic.MVC.Pages.VistaArtista.PerfilModel
@{
    Layout = "~/Pages/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Perfil del Artista";
}

<div class="card p-4 mx-auto" style="max-width: 600px;">
    <h3 class="text-center mb-4"><i class="bi bi-person-circle me-2"></i> Perfil del Artista</h3>

    <div class="text-center mb-3">
        <img src="@Model.Artista?.UrlFotoPerfil ?? " /media/perfil/default-user.png""
             alt="Foto de perfil"
             class="rounded-circle"
             style="width: 120px; height: 120px; object-fit: cover;" />
    </div>

    <dl class="row">
        <dt class="col-sm-4"><i class="bi bi-person-fill me-2"></i> Nombre artístico</dt>
        <dd class="col-sm-8">@Model.Artista?.NombreArtistico</dd>

        <dt class="col-sm-4"><i class="bi bi-info-circle me-2"></i> Biografía</dt>
        <dd class="col-sm-8">@Model.Artista?.Biografia</dd>

        <dt class="col-sm-4"><i class="bi bi-album me-2"></i> Álbumes</dt>
        <dd class="col-sm-8">@Model.Artista?.Albumes?.Count() ?? 0</dd>

        <dt class="col-sm-4"><i class="bi bi-music-note me-2"></i> Canciones</dt>
        <dd class="col-sm-8">@Model.Artista?.Canciones?.Count() ?? 0</dd>
    </dl>

    <div class="text-center">
        <a asp-page="./EditarPerfil" class="btn btn-success">
            <i class="bi bi-pencil-square"></i> Editar Perfil
        </a>
    </div>
</div>
