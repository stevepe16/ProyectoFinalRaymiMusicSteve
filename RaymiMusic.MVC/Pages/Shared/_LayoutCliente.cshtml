@{
    var correo = Context.Session.GetString("Correo");
    var urlFoto = Context.Session.GetString("UrlFoto") ?? "/media/perfil/default-user.png";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - RaymiMusic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
</head>
<body class="bg-dark text-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">
        <a class="navbar-brand" href="#">RaymiMusic</a>

        <!-- Right-aligned user info -->
        <div class="ms-auto d-flex align-items-center">
            <!-- User's email -->
            <span class="text-light me-2"><i class="bi bi-person-circle me-1"></i>@correo</span>
            <div class="dropdown">
                <!-- Profile picture and dropdown menu -->
                <a class="nav-link dropdown-toggle p-0" href="#" id="perfilDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="@urlFoto" alt="Perfil" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" />
                </a>

                <!-- Dropdown menu -->
                <ul class="navbar-nav">
                    @if (Context.Session.GetString("Correo") != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-info">
                                <i class="bi bi-person-circle me-1"></i> @Context.Session.GetString("Correo")
                            </span>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Cuenta/Logout" class="form-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-page="/Cuenta/Login">
                                <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-page="/Cuenta/Register">
                                <i class="bi bi-person-plus"></i> Registrarse
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main content area -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- JS scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
