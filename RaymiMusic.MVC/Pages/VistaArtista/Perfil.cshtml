@page
@model RaymiMusic.MVC.Pages.VistaArtista.PerfilModel
@{
    Layout = "~/Pages/Shared/_LayoutArtista.cshtml";
    ViewData["Title"] = "Perfil del Artista";
}

<div class="container">
    <h3 class="text-center mb-4">Mi Perfil</h3>

    @if (Model.Artista != null)
    {
        <form method="post">
            <div class="row mb-4 align-items-center">
                <!-- Foto de perfil -->
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.Artista?.UrlFotoPerfil))
                    {
                        <img src="@Model.Artista.UrlFotoPerfil" class="img-fluid rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" alt="Foto de perfil" />
                    }
                    else
                    {
                        <img src="/media/perfil/default-user.png" class="img-fluid rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" alt="Foto de perfil" />
                    }
                </div>

                <!-- Nombre artístico y biografía -->
                <div class="col-md-8">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Nombre artístico</h5>
                            <input type="text" class="form-control" value="@Model.Artista?.NombreArtistico" readonly />
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Biografía</h5>
                            <textarea class="form-control" rows="5" readonly>@Model.Artista?.Biografia</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón de actualización (redirige a otra vista) -->
            <div class="d-flex justify-content-center">
                <a href="@Url.Page("/VistaArtista/EditarPerfil")" class="btn btn-success btn-lg">Actualizar Perfil</a>
            </div>
        </form>
    }
</div>
