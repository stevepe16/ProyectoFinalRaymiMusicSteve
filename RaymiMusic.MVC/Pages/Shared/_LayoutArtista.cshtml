@{
    var correo = Context.Session.GetString("Correo");
    var urlFoto = Context.Session.GetString("UrlFoto") ?? "/media/perfil/default-user.png";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - RaymiMusic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
</head>
<body class="bg-dark text-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">
        <a class="navbar-brand" href="#">RaymiMusic</a>

        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link text-light" asp-page="/VistaArtista/Index">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" asp-page="/VistaArtista/Perfil">Ver Perfil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" asp-page="/VistaArtista/SubirCancion">Subir una Cancion</a>
                </li>
            </ul>

            <ul class="navbar-nav">
                @if (Context.Session.GetString("Correo") != null)
                {
                    <li class="nav-item">
                        <span class="nav-link text-info">
                            <i class="bi bi-person-circle me-1"></i> @Context.Session.GetString("Correo")
                        </span>
                    </li>
                    <li class="nav-item">
                        <form method="post" asp-page="/Cuenta/Logout" class="form-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-page="/Cuenta/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-page="/Cuenta/Register">
                            <i class="bi bi-person-plus"></i> Registrarse
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
