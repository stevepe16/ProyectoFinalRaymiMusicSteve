@page
@model RaymiMusic.MVC.Pages.VistaArtista.IndexModel
@{
    Layout = "~/Pages/Shared/_LayoutArtista.cshtml";
    ViewData["Title"] = "Mis Canciones";
}

<div class="container">
    <h3 class="text-center mb-4">Mis Canciones</h3>

    @if (Model.Canciones != null && Model.Canciones.Any())
    {
        <ul class="list-group">
            @foreach (var cancion in Model.Canciones)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@cancion.Titulo</span> <!-- Mostrar el título de la canción -->
                    <a href="@Url.Page("/VistaArtista/Reproducir", new { id = cancion.Id })" class="btn btn-sm btn-info">Reproducir</a>
                </li>
            }
        </ul>
    }
    else
    {
        <p>No tienes canciones registradas.</p>
    }
</div>
