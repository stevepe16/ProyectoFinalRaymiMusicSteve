@page
@model RaymiMusic.MVC.Pages.Oyente.EditarPerfilModel
@{
    Layout = "~/Pages/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Editar perfil";
}

<div class="card p-4 mx-auto" style="max-width: 600px;">
    <h3 class="text-center mb-4"><i class="bi bi-pencil-square me-2"></i> Editar Perfil</h3>

    <form method="post">
        <div class="form-group mb-3">
            <label><i class="bi bi-person-fill me-1"></i> Nombre completo</label>
            <input asp-for="Usuario.Perfil.NombreCompleto" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label><i class="bi bi-calendar3 me-1"></i> Fecha de nacimiento</label>
            <input asp-for="Usuario.Perfil.FechaNacimiento" type="date" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label><i class="bi bi-image me-1"></i> URL de la foto de perfil</label>
            <input asp-for="Usuario.Perfil.UrlFoto" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-save"></i> Guardar cambios
        </button>
    </form>
</div>
