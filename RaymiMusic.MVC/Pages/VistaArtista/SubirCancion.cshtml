@page
@model RaymiMusic.MVC.Pages.VistaArtista.SubirCancionModel
@{
    Layout = "~/Pages/Shared/_LayoutArtista.cshtml";
    ViewData["Title"] = "Subir Canción";
}

<div class="container">
    <h3 class="text-center mb-4">Sube tu Canción</h3>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post" enctype="multipart/form-data">

                <!-- Título de la canción -->
                <div class="mb-3">
                    <label class="form-label">Título de la Canción</label>
                    <input asp-for="Cancion.Titulo" class="form-control" placeholder="Escribe el título" />
                </div>

                <!-- Género de la canción -->
                <div class="mb-3">
                    <label class="form-label">Género</label>
                    <select asp-for="Cancion.GeneroId" class="form-select" asp-items="@(Model.Generos)">
                        <option value="">Selecciona un género</option>
                    </select>
                </div>

                <!-- Subir archivo de la canción -->
                <div class="mb-3">
                    <label class="form-label">Archivo de la Canción</label>
                    <input type="file" asp-for="Archivo" class="form-control" accept="audio/mp3, audio/wav, audio/aac, audio/ogg" />
                </div>

                <!-- Duración -->
                <div class="mb-3">
                    <label class="form-label">Duración</label>
                    <input asp-for="Cancion.Duracion" type="time" class="form-control" step="1" />
                </div>

                <!-- Botón de Enviar -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-upload me-1"></i> Subir Canción
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
