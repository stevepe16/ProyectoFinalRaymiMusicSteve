@page
@model RaymiMusic.MVC.Pages.Oyente.PerfilModel
@{
    Layout = "~/Pages/Cliente/_LayoutCliente.cshtml";
    ViewData["Title"] = "Mi perfil";
}

<div class="card p-4 mx-auto" style="max-width: 600px;">
    <h3 class="text-center mb-4"><i class="bi bi-person-circle me-2"></i> Perfil del Oyente</h3>

    <div class="text-center mb-3">
        <img src="@(string.IsNullOrEmpty(Model.Usuario?.Perfil?.UrlFoto) ? "/media/perfil/default-user.png" : Model.Usuario.Perfil.UrlFoto)"
             alt="Foto de perfil"
             class="rounded-circle"
             style="width: 120px; height: 120px; object-fit: cover;" />

	</div><img src="C:\Users\STEVE\Downloads\JOSE LONG.jpeg" />

    <dl class="row">
        <dt class="col-sm-4"><i class="bi bi-envelope-fill me-2"></i>Correo</dt>
        <dd class="col-sm-8">@Model.Usuario?.Correo</dd>

        <dt class="col-sm-4"><i class="bi bi-person-fill me-2"></i>Nombre</dt>
        <dd class="col-sm-8">@Model.Usuario?.Perfil?.NombreCompleto</dd>

        <dt class="col-sm-4"><i class="bi bi-calendar3 me-2"></i>Nacimiento</dt>
        <dd class="col-sm-8">@Model.Usuario?.Perfil?.FechaNacimiento?.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-4"><i class="bi bi-star-fill me-2"></i>Plan</dt>
        <dd class="col-sm-8">@Model.Usuario?.PlanSuscripcion?.Nombre</dd>

        <dt class="col-sm-4"><i class="bi bi-cash me-2"></i>Precio</dt>
        <dd class="col-sm-8">$@Model.Usuario?.PlanSuscripcion?.Precio</dd>
    </dl>

    <div class="text-center">
        <a asp-page="./EditarPerfil" class="btn btn-success">
            <i class="bi bi-pencil-square"></i> Editar Perfil
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
            <strong>@TempData["Mensaje"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

@* Para que se cierre la alerta*@
@section Scripts {
    <script>
        setTimeout(function () {
            var alert = document.querySelector(".alert");
            if (alert) {
                alert.classList.remove("show");
                alert.classList.add("fade");
            }
        }, 3000);
    </script>
}

@section Scripts {
    <!-- Aquí puedes agregar scripts personalizados si algún día necesitas -->
}


