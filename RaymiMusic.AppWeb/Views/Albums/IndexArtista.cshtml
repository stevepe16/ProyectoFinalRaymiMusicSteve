@model IEnumerable<RaymiMusic.Modelos.Album>
@{
    ViewData["Title"] = "Mis Álbumes";
}

<h2 class="text-black mb-4">Mis Álbumes</h2>

<p>
    <a class="btn btn-success mb-3" asp-action="Create">Crear nuevo álbum</a>
</p>

<table class="table table-dark table-striped table-bordered rounded text-center">
    <thead class="table-primary text-dark">
        <tr>
            <th>Título</th>
            <th>Fecha de Lanzamiento</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var album in Model)
        {
            <tr>
                <td>@album.Titulo</td>
                <td>@(album.FechaLanzamiento?.ToString("dd/MM/yyyy") ?? "Sin fecha")</td>
                <td>
                    <a class="btn btn-info btn-sm me-1" asp-action="Details" asp-route-id="@album.Id">Ver</a>
                    <a class="btn btn-warning btn-sm me-1" asp-action="Edit" asp-route-id="@album.Id">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@album.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
